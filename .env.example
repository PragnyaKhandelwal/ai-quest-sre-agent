# ---------------------------------------------------------------------------
# Lyzr platform (https://lyzr.ai -- sign up, create a project, copy the API key
# from Settings > API Keys). If left blank, the system runs in fully
# functional LOCAL SIMULATION mode: every agent produces deterministic,
# schema-validated output instead of calling the Lyzr Agent API, so the
# entire demo works end-to-end with zero external dependencies.
# ---------------------------------------------------------------------------
LYZR_API_KEY=
LYZR_BASE_URL=https://agent.api.lyzr.ai/v2
LYZR_AIMS_URL=https://aims.api.lyzr.ai/v1

# Optional: only needed if you point Lyzr agents at your own OpenAI key
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Model / governance configuration (single source of truth: agents/config.py)
# ---------------------------------------------------------------------------
MODEL=gpt-4o-mini
MAX_TOKENS=1000
TEMPERATURE=0.2
CONFIDENCE_THRESHOLD=0.70
HITL_TIMEOUT_SECONDS=300
DEDUP_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# Backend / frontend wiring
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# Local fallback audit log path (used automatically if Lyzr AIMS is unreachable)
AIMS_LOCAL_FALLBACK_PATH=aims_events.log.jsonl
